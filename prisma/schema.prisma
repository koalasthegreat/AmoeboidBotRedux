// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Settings {
  id    String @id
  left  String
  right String
}

model CachedCard {
  query       String @id
  lastQueried DateTime
  card        String
}
